[Unit]
Description=xrayclient-reversepanel (VLESS reverse client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/local/xrayclient-reversepanel
ExecStart=/usr/local/xrayclient-reversepanel/xrayclient-reversepanel -c /usr/local/xrayclient-reversepanel/config.json
Restart=always
RestartSec=5s
LimitNOFILE=65535

# 加固：只允许写自己的目录（网页保存配置需要）
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/usr/local/xrayclient-reversepanel
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
